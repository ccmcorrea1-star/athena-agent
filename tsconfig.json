{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"@athena/ai": ["./packages/ai/src/index.ts"],
			"@athena/ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@athena/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@athena/ai/dist/*": ["./packages/ai/src/*"],
			"@athena/agent-core": ["./packages/agent/src/index.ts"],
			"@athena/agent-core/*": ["./packages/agent/src/*"],
			"@athena/agent-sqlite-node": ["./packages/storage/sqlite-node/src/index.ts"],
			"@athena/coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@athena/coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@athena/coding-agent/*": ["./packages/coding-agent/src/*"],
			"@athena/protocol": ["./packages/protocol/src/index.ts"],
			"@athena/protocol/*": ["./packages/protocol/src/*"],
			"@athena/client": ["./packages/client/src/index.ts"],
			"@athena/client/*": ["./packages/client/src/*"],
			"@athena/server": ["./packages/server/src/index.ts"],
			"@athena/server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@athena/tui": ["./packages/tui/src/index.ts"],
			"@athena/tui/*": ["./packages/tui/src/*"],
			"@athena/agent-old": ["./packages/agent-old/src/index.ts"],
			"@athena/agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/storage/*/src/**/*", "packages/storage/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
